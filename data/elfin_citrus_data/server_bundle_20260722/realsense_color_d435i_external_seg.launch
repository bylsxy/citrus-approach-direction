<launch>
    <arg name="segmentation_backend" default="dummy" />
    <arg name="model_path" default="" />
    <arg name="class_yaml" default="$(find pose_graph)/config/orchard_classes.yaml" />
    <arg name="class_color_yaml" default="$(find pose_graph)/config/segmentation_colors.yaml" />
    <arg name="confidence_threshold" default="0.25" />
    <arg name="iou_threshold" default="0.5" />
    <arg name="device" default="cuda:0" />
    <arg name="input_size" default="640" />
    <arg name="save_debug_masks" default="true" />
    <arg name="debug_save_dir" default="/home/aiseon/zzhslam/outputs/stage3_external_segmentation/masks" />
    <arg name="external_mask_topic" default="/segmentation/output/color_mask" />

    <node name="segmentation_backend_node" pkg="pose_graph" type="segmentation_backend_node.py" output="screen">
        <remap from="/segmentation/input/image" to="/camera/color/image_raw" />
        <param name="segmentation_backend" value="$(arg segmentation_backend)" />
        <param name="model_path" value="$(arg model_path)" />
        <param name="class_yaml" value="$(arg class_yaml)" />
        <param name="class_color_yaml" value="$(arg class_color_yaml)" />
        <param name="confidence_threshold" value="$(arg confidence_threshold)" />
        <param name="iou_threshold" value="$(arg iou_threshold)" />
        <param name="device" value="$(arg device)" />
        <param name="input_size" value="$(arg input_size)" />
        <param name="save_debug_masks" value="$(arg save_debug_masks)" />
        <param name="debug_save_dir" value="$(arg debug_save_dir)" />
    </node>

    <include file="$(find vins_estimator)/launch/realsense_color_d435i.launch">
        <arg name="segmentation_backend" value="external_mask_topic" />
        <arg name="external_mask_topic" value="$(arg external_mask_topic)" />
    </include>
</launch>
