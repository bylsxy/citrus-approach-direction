*.jpeg binary
*.gif binary
*.mp4 binary
*.avi binary
*.mov binary
*.onnx binary
*.pt binary
*.pth binary
*.engine binary
*.npz binary
*.npy binary
*.doc binary
*.docx binary
*.pdf binary
*.stl binary
*.step binary
